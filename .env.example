# Copy to .env and fill in. Never commit .env.

# From https://aistudio.google.com/apikey (free tier)
NUXT_GEMINI_API_KEY=
# Called through Google's Interactions API. The Gemini 2.5 models are closed to new
# API keys, so a new key needs a 3.x model: gemini-3.5-flash-lite is fast and cheap.
NUXT_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. If set, the upload form needs this passcode.
NUXT_UPLOAD_PASSCODE=

# Your Vercel URL in production, used for canonical URLs and the sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Set automatically on Vercel when you add Upstash from the marketplace
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
